# Copy to .env and fill in. Never commit .env.

# SQLite works out of the box. For production use PostgreSQL:
#   pip install -e ".[postgres]"
#   AIFACE_DATABASE_URL=postgresql+asyncpg://aiface:CHANGE_ME@localhost:5432/aiface
AIFACE_DATABASE_URL=sqlite+aiosqlite:///./aiface.db
AIFACE_HOST=0.0.0.0
AIFACE_PORT=8000

# Required before exposing the dashboard/API outside your LAN.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AIFACE_API_TOKEN=

AIFACE_DUPLICATE_WINDOW_SECONDS=60
AIFACE_PHOTOS_DIR=data/photos
AIFACE_PHOTOS_LOCAL_ONLY=true

# Webhook relay (leave AIFACE_RELAY_URL empty to disable)
AIFACE_RELAY_URL=
AIFACE_RELAY_TOKEN=
AIFACE_RELAY_TOKEN_HEADER=X-Relay-Token
AIFACE_RELAY_DEVICES=
AIFACE_RELAY_SINCE=
